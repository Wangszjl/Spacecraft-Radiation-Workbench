@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.5 COMPONENTS Core)
if(@SPACERAD_BUILD_DESKTOP@)
 find_dependency(Qt6 COMPONENTS Widgets OpenGLWidgets)
 find_dependency(VTK COMPONENTS CommonCore CommonDataModel FiltersSources RenderingCore RenderingOpenGL2 InteractionStyle GUISupportQt)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SpaceRadTargets.cmake")
check_required_components(SpaceRad)
