{
  "version": 3,
  "configurePresets": [
    {
      "name": "desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "SPACERAD_BUILD_DESKTOP": "ON",
        "SPACERAD_BUILD_WORKER": "ON"
      }
    },
    {
      "name": "worker",
      "inherits": "desktop",
      "binaryDir": "${sourceDir}/build/worker",
      "cacheVariables": {
        "SPACERAD_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "model",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/model",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "SPACERAD_BUILD_SERVICES": "OFF",
        "SPACERAD_BUILD_DESKTOP": "OFF",
        "SPACERAD_BUILD_WORKER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "worker",
      "configurePreset": "worker"
    },
    {
      "name": "model",
      "configurePreset": "model"
    }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "model",
      "configurePreset": "model",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
